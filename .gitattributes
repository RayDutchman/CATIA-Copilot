# 统一行尾符：工作区使用 CRLF（Windows 原生开发环境）
# Git 仓库内统一存储为 LF，checkout 时转为 CRLF，commit 时转为 LF
# 无论 opencode / VSCode / 其他工具写入 LF 还是 CRLF，commit 时统一转为 LF

# 默认：所有文本文件 CRLF
* text=auto eol=crlf

# Python / 配置 / 文档 — 明确 CRLF
*.py        text eol=crlf
*.pyw       text eol=crlf
*.qss       text eol=crlf
*.md        text eol=crlf
*.txt       text eol=crlf
*.json      text eol=crlf
*.toml      text eol=crlf
*.yaml      text eol=crlf
*.yml       text eol=crlf
*.cfg       text eol=crlf
*.ini       text eol=crlf
*.spec      text eol=crlf
*.svg       text eol=crlf
*.html      text eol=crlf
*.css       text eol=crlf
*.xml       text eol=crlf
*.catvbs    text eol=crlf
*.catscript text eol=crlf

# Windows 脚本
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Shell 脚本 — LF（在 Linux/WSL 执行）
*.sh        text eol=lf

# 二进制文件 — 不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.bmp   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.7z    binary
*.exe   binary
*.dll   binary
*.pyd   binary
*.pyc   binary

# CATIA 原生格式 — 二进制，禁止行尾转换
*.CATPart     binary
*.CATProduct  binary
*.CATDrawing  binary
*.CATAnalysis binary
*.cgr         binary
*.3dxml       binary
