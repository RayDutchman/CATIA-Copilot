# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/
MANIFEST

# ── PyInstaller ──────────────────────────────────────────────────────────────
# Compiled output – regenerated by `pyinstaller build.spec` (already covered above)
# Keep hand-edited .spec files (e.g. build.spec), but ignore auto-generated ones
*.spec
!build.spec

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
*.lnk
$RECYCLE.BIN/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── QSettings / runtime config ───────────────────────────────────────────────
# Ignore auto-generated config files; keep manually committed ones if any
*.ini
*.cfg
tmp/
# macros/
crack/
test.py

# ── AI Agent 配置（含 API Key，不提交）────────────────────────────────────────
ai_config.json

# ── AI 会话数据（含对话历史，不提交）─────────────────────────────────────────
ai_sessions/

# ── AI 全局长期记忆（用户私有，不提交）───────────────────────────────────────
memory.md

# ── Playwright MCP ───────────────────────────────────────────────────────────
.playwright-mcp/

# ── OpenCode 工作区 ───────────────────────────────────────────────────────────
.opencode/*
!.opencode/instructions.md

# ── 临时 / 探查 / 开发笔记（不属于正式代码库）────────────────────────────────
tests/
experiments/
examples/
modules/