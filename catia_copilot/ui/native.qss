/* ═══════════════════════════════════════════════════════════════════
   CATIA Copilot – 原生主题（Windows 系统主题）

   本文件配合 QApplication.setStyle("windowsvista") 使用。
   windowsvista 风格完全跟随 Windows 系统主题（包括深色模式），
   字体、圆角、颜色均由 Windows 决定，本文件只写项目专属控件的
   最小覆盖，其余控件全部留空由系统渲染器接管。
   ═══════════════════════════════════════════════════════════════════ */

/* ── 节标题标签 ─────────────────────────────────────────────────────── */
QLabel#sectionLabel {
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 6px 0 2px 0;
    background: transparent;
}

/* ── 提示标签 ───────────────────────────────────────────────────────── */
QLabel#hintLabel {
    font-size: 9pt;
    background: transparent;
    margin-bottom: 4px;
}

/* ── CATIA 连接状态指示器 ───────────────────────────────────────────── */
QLabel#catiaStatusLabel { padding: 0 8px; font-size: 8.5pt; }
QLabel#catiaStatusLabel[catiaConnected="true"]   { color: #1a6b1a; }
QLabel#catiaStatusLabel[catiaConnected="false"]  { color: #cc2200; }
QLabel#catiaStatusLabel[catiaConnected="broken"] { color: #996600; }

/* ── 日志面板（等宽字体，windowsvista 风格不自动设置）──────────────── */
QPlainTextEdit#logView {
    font-family: @log_font_family;
    font-size: @log_font_size;
}
QLabel#logPathLabel {
    font-size: 8.5pt;
    background: transparent;
}

/* ── AI 聊天面板：布局容器圆角/边框清零 ─────────────────────────────── */
/* windowsvista 风格会给部分容器加边框，这里精确清零避免多余边框线 */
QWidget#ChatArea,
QWidget#ToolbarWrapper,
QWidget#ToolbarBar,
QWidget#InputArea {
    border: none;
    border-radius: 0px;
}
QWidget#SidebarHeader,
QWidget#SidebarBottom {
    border: none;
    border-radius: 0px;
}
QSplitter#InputSplitter {
    border-radius: 0px;
}
QSplitter#InputSplitter::handle {
    border-radius: 0px;
    image: none;
}
