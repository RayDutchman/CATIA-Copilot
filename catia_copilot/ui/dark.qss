
/* ═══════════════════════════════════════════════════════════════════
   CATIA Copilot – 项目专属覆盖层（Dark）
   本文件追加在 qdarkstyle 基础层之上，只写 qdarkstyle 未覆盖或需要
   覆盖的部分；通用控件样式（按钮、输入框、滚动条等）由 qdarkstyle 提供。
   ═══════════════════════════════════════════════════════════════════ */

/* ── 基础背景 ─────────────────────────────────────────────────────── */
QMainWindow { background-color: #19232D; }
QDialog     { background-color: #19232D; }

/* ── 标题栏 ──────────────────────────────────────────────────────── */
QWidget#titleBar {
    background-color: #293544;
    border-bottom: 1px solid #37414F;
}
QLabel#titleBarTitle {
    color: #e0e0e0;
    font-size: 9pt;
    font-weight: 500;
    background: transparent;
}

/* ── Tab 按钮（自定义标题栏内）─────────────────────────────────── */
QPushButton#titleTabButton {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    color: #9DA9B5;
    font-size: 9pt;
    padding: 0 16px;
    margin: 4px 0 0 0;
    min-height: 32px;
    min-width: 0;
}
QPushButton#titleTabButton:hover {
    background-color: #37414F;
    color: #e0e0e0;
}
QPushButton#titleTabButton:checked {
    border-bottom: 2px solid #346792;
    color: #e0e0e0;
    background-color: #2f3f50;
    font-weight: 600;
}

/* ── QTabWidget / QTabBar ─────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #37414F;
    background-color: #19232D;
}
QTabBar {
    background-color: #293544;
}
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    color: #9DA9B5;
    font-size: 9pt;
    padding: 0 16px;
    margin: 4px 0 0 0;
    min-height: 32px;
    min-width: 0;
}
QTabBar::tab:hover {
    background-color: #37414F;
    color: #e0e0e0;
}
QTabBar::tab:selected {
    border-bottom: 2px solid #346792;
    color: #e0e0e0;
    background-color: #2f3f50;
    font-weight: 600;
}
QTabBar::tab:last {
    font-weight: 400;
}

/* ── 主界面专属样式 ───────────────────────────────────────────────── */
/* 主界面 Tab 标题左右 padding 增加 */
QTabWidget#mainTabWidget QTabBar::tab {
    padding: 0 13px;
}
/* 主界面功能按钮高度增加 */
QTabWidget#mainTabWidget QPushButton {
    min-height: 30px;
}
/* Toggle 按钮：选中时蓝色高亮，视觉上区别于普通按钮 */
QPushButton#toggleButton:checked {
    background-color: #346792;
    color: #ffffff;
    border: 1px solid #2a5578;
}
QPushButton#toggleButton:checked:hover {
    background-color: #3d7aab;
}

/* ── 标题栏 caption 按钮（≡ / 最小化 / 最大化）Win11 原生规格 ───── */
QPushButton#titleBarMoreBtn,
QPushButton#titleBarMinBtn,
QPushButton#titleBarMaxBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: #c0c0c0;
    font-size: 10pt;
    padding: 0;
    min-width: 46px;  max-width: 46px;
    min-height: 40px; max-height: 40px;
}
QPushButton#titleBarMoreBtn:hover,
QPushButton#titleBarMinBtn:hover,
QPushButton#titleBarMaxBtn:hover {
    background-color: rgba(255, 255, 255, 26);
    color: #ffffff;
}
QPushButton#titleBarMoreBtn:pressed,
QPushButton#titleBarMinBtn:pressed,
QPushButton#titleBarMaxBtn:pressed {
    background-color: rgba(255, 255, 255, 18);
    color: #d0d0d0;
}

/* ── 关闭按钮（红色 hover，Win11 规格）──────────────────────────── */
QPushButton#titleBarCloseBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: #c0c0c0;
    font-size: 10pt;
    padding: 0;
    min-width: 46px;  max-width: 46px;
    min-height: 40px; max-height: 40px;
}
QPushButton#titleBarCloseBtn:hover  { background-color: #c42b1c; color: #ffffff; }
QPushButton#titleBarCloseBtn:pressed { background-color: #a82315; color: #ffffff; }

/* ── 节标题标签 ─────────────────────────────────────────────────────── */
QLabel#sectionLabel {
    color: #9DA9B5;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 6px 0 2px 0;
    background: transparent;
}

/* ── 提示标签 ───────────────────────────────────────────────────────── */
QLabel#hintLabel {
    color: #9DA9B5;
    font-size: 9pt;
    background: transparent;
    margin-bottom: 4px;
}

/* ── CATIA 连接状态指示器 ───────────────────────────────────────────── */
QLabel#catiaStatusLabel { padding: 0 8px; font-size: 8.5pt; color: #9DA9B5; }
QLabel#catiaStatusLabel[catiaConnected="true"]   { color: #4ec94e; }
QLabel#catiaStatusLabel[catiaConnected="false"]  { color: #f04b4b; }
QLabel#catiaStatusLabel[catiaConnected="broken"] { color: #e0a030; }

/* ── tree 内嵌 QComboBox（与行高融合，无边框）──────────────────────── */
QComboBox#treeCombo {
    background-color: transparent;
    border: none;
    border-radius: 0;
    color: #e8e8e8;
    padding: 0px 4px;
    min-height: 0;
    max-height: 24px;
}
QComboBox#treeCombo:hover  { background-color: #37414F; }
QComboBox#treeCombo:focus  { background-color: #26486B; }
QComboBox#treeCombo::drop-down { border: none; width: 20px; }
QComboBox#treeCombo::down-arrow {
    width: 10px;
    height: 10px;
    image: url(@chevron_down_icon);
}
QComboBox#treeCombo QAbstractItemView {
    background-color: #293544;
    border: 1px solid #37414F;
    border-radius: @control_radiuspx;
    selection-background-color: #26486B;
    color: #e8e8e8;
    outline: none;
}

/* ── 日志面板 ──────────────────────────────────────────────────────── */
QWidget#logPanel {
    background-color: #111820;
    border-top: 1px solid #37414F;
}
QPlainTextEdit#logView {
    background-color: #111820;
    color: #d4d4d4;
    border: none;
    border-radius: 0px;
    font-family: @log_font_family;
    font-size: @log_font_size;
}
QLabel#logPathLabel {
    color: #546476;
    font-size: 8.5pt;
    background: transparent;
}

/* ── branch 区域选中/hover 背景色与 item 保持一致，消除系统焦点框线 ── */
QTreeView:branch:selected       { background-color: #346792; }
QTreeView:branch:hover          { background-color: #37414F; }
QTreeView:branch:selected:hover { background-color: #346792; }

/* ── item 选中色在窗口失焦/hover 其他行时保持不变 ── */
QTreeView::item:selected:!active,
QListView::item:selected:!active,
QTableView::item:selected:!active {
  color: #DFE1E2;
  background-color: #346792;
}
QTreeView:branch:selected:!active { background-color: #346792; }

/* ── AI 聊天面板：输入区垂直 splitter handle ─────────────────────────── */
/* qdarkstyle 给 QSplitter 设置了 #455364 蓝色，输入区 splitter 应融入背景 */
QSplitter#InputSplitter {
  background-color: #19232D;
  border-radius: 0px;
}
QSplitter#InputSplitter::handle {
  background-color: #37414F;
  border: none;
  border-radius: 0px;
  image: none;
}

/* ── AI 聊天面板：布局容器圆角清零 ──────────────────────────────────────── */
/* qdarkstyle 有 QWidget { border-radius: 4px } 全局规则，导致布局容器在    */
/* QSplitter 背景上出现圆角漏色。用 objectName 选择器精确清零。              */
QWidget#ChatArea,
QWidget#ToolbarWrapper,
QWidget#ToolbarBar,
QWidget#InputArea {
  border-radius: 0px;
}
/* 侧边栏标题栏和底部区域：同时清除 qdarkstyle 加的黑色边框 */
QWidget#SidebarHeader,
QWidget#SidebarBottom {
  border: none;
  border-radius: 0px;
}
/* 侧边栏会话列表：去掉 qdarkstyle 给 QListView 加的圆角和边框 */
SessionSidebar QListWidget#SessionList {
  border: none;
  border-radius: 0px;
}
SessionSidebar QListWidget#SessionList::item {
  border-radius: 0px;
}
