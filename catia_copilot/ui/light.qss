
/* ═══════════════════════════════════════════════════════════════════
   CATIA Copilot – 项目专属覆盖层（Light）
   本文件追加在 qdarkstyle 基础层之上，只写 qdarkstyle 未覆盖或需要
   覆盖的部分；通用控件样式（按钮、输入框、滚动条等）由 qdarkstyle 提供。
   ═══════════════════════════════════════════════════════════════════ */

/* ── 基础背景 ─────────────────────────────────────────────────────── */
QMainWindow { background-color: #FAFAFA; }
QDialog     { background-color: #FAFAFA; }

/* ── 标题栏 ──────────────────────────────────────────────────────── */
QWidget#titleBar {
    background-color: #DFE1E2;
    border-bottom: 1px solid #D2D5D8;
}
QLabel#titleBarTitle {
    color: #19232D;
    font-size: 9pt;
    font-weight: 500;
    background: transparent;
}

/* ── Tab 按钮（自定义标题栏内）─────────────────────────────────── */
QPushButton#titleTabButton {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    color: #54687A;
    font-size: 9pt;
    padding: 0 16px;
    margin: 4px 0 0 0;
    min-height: 32px;
    min-width: 0;
}
QPushButton#titleTabButton:hover {
    background-color: #D2D5D8;
    color: #19232D;
}
QPushButton#titleTabButton:checked {
    border-bottom: 2px solid #346792;
    color: #19232D;
    background-color: #DAEDFF;
    font-weight: 600;
}

/* ── QTabWidget / QTabBar ─────────────────────────────────────────── */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #D2D5D8;
    background-color: #FAFAFA;
}
QTabBar {
    background-color: #DFE1E2;
}
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    color: #54687A;
    font-size: 9pt;
    padding: 0 16px;
    margin: 4px 0 0 0;
    min-height: 32px;
    min-width: 0;
}
QTabBar::tab:hover {
    background-color: #D2D5D8;
    color: #19232D;
}
QTabBar::tab:selected {
    border-bottom: 2px solid #346792;
    color: #19232D;
    background-color: #DAEDFF;
    font-weight: 600;
}
QTabBar::tab:last {
    font-weight: 400;
}

/* ── 主界面专属样式 ───────────────────────────────────────────────── */
/* 主界面 Tab 标题左右 padding 增加 */
QTabWidget#mainTabWidget QTabBar::tab {
    padding: 0 29px;
}
/* 主界面功能按钮高度增加 */
QTabWidget#mainTabWidget QPushButton {
    min-height: 40px;
}

/* ── 标题栏 caption 按钮（≡ / 最小化 / 最大化）Win11 原生规格 ───── */
QPushButton#titleBarMoreBtn,
QPushButton#titleBarMinBtn,
QPushButton#titleBarMaxBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: #293544;
    font-size: 10pt;
    padding: 0;
    min-width: 46px;  max-width: 46px;
    min-height: 40px; max-height: 40px;
}
QPushButton#titleBarMoreBtn:hover,
QPushButton#titleBarMinBtn:hover,
QPushButton#titleBarMaxBtn:hover {
    background-color: rgba(0, 0, 0, 20);
    color: #19232D;
}
QPushButton#titleBarMoreBtn:pressed,
QPushButton#titleBarMinBtn:pressed,
QPushButton#titleBarMaxBtn:pressed {
    background-color: rgba(0, 0, 0, 12);
    color: #37414F;
}

/* ── 关闭按钮（红色 hover，Win11 规格）──────────────────────────── */
QPushButton#titleBarCloseBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: #293544;
    font-size: 10pt;
    padding: 0;
    min-width: 46px;  max-width: 46px;
    min-height: 40px; max-height: 40px;
}
QPushButton#titleBarCloseBtn:hover  { background-color: #c42b1c; color: #ffffff; }
QPushButton#titleBarCloseBtn:pressed { background-color: #a82315; color: #ffffff; }

/* ── 节标题标签 ─────────────────────────────────────────────────────── */
QLabel#sectionLabel {
    color: #54687A;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 6px 0 2px 0;
    background: transparent;
}

/* ── 提示标签 ───────────────────────────────────────────────────────── */
QLabel#hintLabel {
    color: #54687A;
    font-size: 9pt;
    background: transparent;
    margin-bottom: 4px;
}

/* ── CATIA 连接状态指示器 ───────────────────────────────────────────── */
QLabel#catiaStatusLabel { padding: 0 8px; font-size: 8.5pt; color: #54687A; }
QLabel#catiaStatusLabel[catiaConnected="true"]   { color: #2e7d2e; }
QLabel#catiaStatusLabel[catiaConnected="false"]  { color: #c0392b; }
QLabel#catiaStatusLabel[catiaConnected="broken"] { color: #b07d10; }

/* ── tree 内嵌 QComboBox（与行高融合，无边框）──────────────────────── */
QComboBox#treeCombo {
    background-color: transparent;
    border: none;
    border-radius: 0;
    color: #19232D;
    padding: 0px 4px;
    min-height: 0;
    max-height: 24px;
}
QComboBox#treeCombo:hover  { background-color: #D2D5D8; }
QComboBox#treeCombo:focus  { background-color: #DAEDFF; }
QComboBox#treeCombo::drop-down { border: none; width: 20px; }
QComboBox#treeCombo::down-arrow {
    width: 10px;
    height: 10px;
    image: url(@chevron_down_icon);
}
QComboBox#treeCombo QAbstractItemView {
    background-color: #FAFAFA;
    border: 1px solid #D2D5D8;
    border-radius: @control_radiuspx;
    selection-background-color: #DAEDFF;
    color: #19232D;
    outline: none;
}

/* ── 日志面板 ──────────────────────────────────────────────────────── */
QWidget#logPanel {
    background-color: #F0F2F3;
    border-top: 1px solid #D2D5D8;
}
QPlainTextEdit#logView {
    background-color: #FFFFFF;
    color: #19232D;
    border: none;
    border-radius: 0px;
    font-family: @log_font_family;
    font-size: @log_font_size;
}
QLabel#logPathLabel {
    color: #54687A;
    font-size: 8.5pt;
    background: transparent;
}

/* ── branch 区域选中/hover 背景色与 item 保持一致，消除 Win11 蓝色焦点竖线 ── */
QTreeView:branch:selected       { background-color: #9FCBFF; }
QTreeView:branch:hover          { background-color: #D2D5D8; }
QTreeView:branch:selected:hover { background-color: #9FCBFF; }

/* ── item 选中色在窗口失焦/hover 其他行时保持不变 ── */
QTreeView::item:selected:!active,
QListView::item:selected:!active,
QTableView::item:selected:!active {
  color: #19232D;
  background-color: #9FCBFF;
}
QTreeView:branch:selected:!active { background-color: #9FCBFF; }
