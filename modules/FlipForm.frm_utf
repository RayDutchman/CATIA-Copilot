Private Sub UserForm_Activate()
    ' 窗体显示后立即进入连续选孔循环
    ' 在 FlipForm 自身的事件调用栈中运行，消息泵不被阻断，三个按钮全程可响应
    Call DoSelectAndPlace
    ' DoSelectAndPlace 返回时循环已退出，在此安全执行收尾
    Unload Me
    MsgBox "装配完成！" & Chr(10) & _
           "共装配 " & g_count & " 个 " & g_fastenerPN & " 到 " & g_targetPN & "。", _
           vbInformation, "快速装配紧固件"
End Sub

Private Sub btnFlip_Click()
    If Not g_loopActive Then Exit Sub
    btnFlip.Enabled = False
    g_flipDir = Not g_flipDir
    If g_hasLastComp Then
        Call MoveLastFastener
        CATIA.StatusBar = "已重新定向  [翻转:" & IIf(g_flipDir, "是", "否") & "]  继续选孔，按 ESC 或点""退出""结束"
    End If
    btnFlip.Enabled = True
End Sub

Private Sub btnUndo_Click()
    If Not g_loopActive Then Exit Sub
    btnUndo.Enabled = False
    If g_historyCount > 0 Then Call UndoLastFastener
End Sub

Private Sub btnStop_Click()
    ' 设退出标志，发 ESC 让 SelectElement2 返回
    ' DoSelectAndPlace 检测到 g_loopActive=False 后跳出循环并返回
    ' UserForm_Activate 随后执行 Unload Me 和 MsgBox
    g_loopActive = False
    g_hasLastComp = False
    On Error Resume Next
    SendKeys "{ESC}", True
    DoEvents
    On Error GoTo 0
End Sub

Private Sub UserForm_QueryClose(Cancel As Integer, CloseMode As Integer)
    ' 右上角关闭：与 btnStop 等效
    ' 阻止系统直接销毁窗体（让 UserForm_Activate 的 Unload Me 来做）
    If g_loopActive Then
        Cancel = True
        g_loopActive = False
        g_hasLastComp = False
        On Error Resume Next
        SendKeys "{ESC}", True
        DoEvents
        On Error GoTo 0
    End If
End Sub

Private Sub UserForm_Click()

End Sub
