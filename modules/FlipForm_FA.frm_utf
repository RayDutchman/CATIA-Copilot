Private Sub UserForm_Activate()
    ' 窗体显示后立即进入连续选孔循环
    ' 在 FlipForm_FA 自身的事件调用栈中运行，消息泵不被阻断，三个按钮全程可响应
    Call DoSelectAndPlace_FA
    ' DoSelectAndPlace_FA 返回时循环已退出，在此安全执行收尾
    Unload Me
    MsgBox "装配完成！" & Chr(10) & _
           "共装配 " & g_count_FA & " 个 " & g_fastenerPN & " 到 " & g_targetPN_FA & "。", _
           vbInformation, "快速装配紧固件"
End Sub

Private Sub btnFlip_Click()
    If Not g_loopActive_FA Then Exit Sub
    btnFlip.Enabled = False
    g_flipDir_FA = Not g_flipDir_FA
    If g_hasLastComp_FA Then
        Call MoveLastFastener
        CATIA.StatusBar = "已重新定向  [翻转:" & IIf(g_flipDir_FA, "是", "否") & "]  继续选孔，按 ESC 或点""退出""结束"
    End If
    btnFlip.Enabled = True
End Sub

Private Sub btnUndo_Click()
    If Not g_loopActive_FA Then Exit Sub
    btnUndo.Enabled = False
    If g_historyCount_FA > 0 Then Call UndoLastFastener
End Sub

Private Sub btnStop_Click()
    g_loopActive_FA = False
    g_hasLastComp_FA = False
    On Error Resume Next
    SendKeys "{ESC}", True
    DoEvents
    On Error GoTo 0
End Sub

Private Sub UserForm_QueryClose(Cancel As Integer, CloseMode As Integer)
    If g_loopActive_FA Then
        Cancel = True
        g_loopActive_FA = False
        g_hasLastComp_FA = False
        On Error Resume Next
        SendKeys "{ESC}", True
        DoEvents
        On Error GoTo 0
    End If
End Sub

Private Sub UserForm_Click()

End Sub
