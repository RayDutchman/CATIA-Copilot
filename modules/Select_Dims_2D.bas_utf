Option Explicit
Sub CATMain()
IntCATIA
SelectDims oActDoc
End Sub

Sub SelectDims(oDocDrw)
On Error Resume Next
If TypeName(oDocDrw) <> "DrawingDocument" Then
MsgBox "此命令只能在工程制图模块下运行!"
Exit Sub
End If
    Dim Selection
    Dim Status
    Dim InputObjectType(0)
    InputObjectType(0) = "DrawingDimension"
        
    Set Selection = oDocDrw.Selection
    Selection.Clear
    Do Until (Status = "Cancel" Or Status = "Undo" Or Status = "Redo")
    Status = Selection.SelectElement3(InputObjectType, "Please select dimensions", False, CATMultiSelTriggWhenUserValidatesSelection, False)
    If Status = "Normal" Then Exit Do
    Loop
End Sub
'Func SelectElement3( CATSafeArrayVariant  iFilterType, CATBSTR  iMessage, boolean  iObjectSelectionBeforeCommandUsePossibility, CATMultiSelectionMode  iMultiSelectionMode, boolean  iTooltip) As CATBSTR
