Option Explicit
' fastener_assembly - VBA 模块
' ── 调试开关：改为 False 关闭所有 [DEBUG] 弹窗（正式使用时设为 False）──────────
Public Const DEBUG_MODE_FA As Boolean = False

' 翻转方向标志；由 FlipForm_FA 按钮切换，跨次运行保持状态
Public g_flipDir_FA As Boolean

' 紧固件参考几何（由 ContinueSelectFastener 读取一次，PlaceFastenerAtHole 使用）
Public g_faAxis(2)       ' 不声明 As Double，避免某些 CATIA 版本 GetAxis 无法写入
Public g_faAnchorPt(2)

' 最近一次孔的几何（选孔后更新，供翻转重装使用）
Public g_holeAxisX As Double, g_holeAxisY As Double, g_holeAxisZ As Double
Public g_holePtX_FA   As Double, g_holePtY_FA   As Double, g_holePtZ_FA   As Double

' 最近装配件的信息（翻转重装时使用）
Public g_hasLastComp_FA  As Boolean
Public g_lastProducts_FA As Object
Public g_lastCompIdx_FA  As Long

' 装配历史记录（供撤销使用）
Public g_assemblyHistory_FA()
Public g_historyCount_FA As Long

' 装配循环活动标志
Public g_loopActive_FA As Boolean

' 装配循环共享状态
Public targetProduct_FA   As Object
Public g_fastenerDoc   As Object
Public g_fastenerPN    As String
Public g_targetPN_FA      As String
Public g_count_FA         As Long

' ============================================================================
' CATMain
' ============================================================================
Public Sub CATMain()
    CATIA.StatusBar = "请切换到紧固件（CATPart）文档窗口，然后点击浮动面板上的""继续""按钮。"
    SwitchToPartForm_FA.Show vbModeless
End Sub

' ============================================================================
' ContinueSelectFastener - 由 SwitchToPartForm_FA.btnContinue_Click() 调用。
' ============================================================================
Public Sub ContinueSelectFastener()
    If TypeName(CATIA.ActiveDocument) <> "PartDocument" Then
        MsgBox "当前活动文档不是 CATPart。" & Chr(10) & _
               "请先切换到紧固件文档窗口，然后再点击""继续""。", _
               vbExclamation, "快速装配紧固件"
        Exit Sub
    End If

    Unload SwitchToPartForm_FA

    Dim fastenerDoc As Object
    Set fastenerDoc = CATIA.ActiveDocument
    Set g_fastenerDoc = fastenerDoc
    g_fastenerPN = fastenerDoc.Product.PartNumber

    Dim sel As Object
    Set sel = fastenerDoc.Selection
    sel.Clear

    Dim fastEdgeFilter As Variant
    fastEdgeFilter = Array("MonoDim")
    Dim spaFastener As Object
    Set spaFastener = fastenerDoc.GetWorkbench("SPAWorkbench")

    Dim fastEdgeRef As Object
    Dim fastEdgeMeas As Object
    Dim faAxis(2)
    Dim faAnchorPt(2)
    Dim bFaGeomOK As Boolean
    Dim status As String

    Do
        status = sel.SelectElement2(fastEdgeFilter, _
            "请选择紧固件安装面上的圆或圆弧（确定轴向和定位点）[ESC 退出]", False)
        If status <> "Normal" Then Exit Sub

        Set fastEdgeRef = sel.Item(1).Reference
        Set fastEdgeMeas = spaFastener.GetMeasurable(fastEdgeRef)

        bFaGeomOK = TryGetAxis_FA(fastEdgeMeas, faAxis) And TryGetCenter_FA(fastEdgeMeas, faAnchorPt)
        If Not bFaGeomOK Then
            MsgBox "无法从所选元素获取轴向和圆心。" & Chr(10) & _
                   "请选择一个圆或一段圆弧（而非直线或曲线）。", _
                   vbExclamation, "快速装配紧固件"
            sel.Clear
        End If
    Loop While Not bFaGeomOK

    sel.Clear

    Dim faLen As Double
    faLen = Sqr(faAxis(0) * faAxis(0) + faAxis(1) * faAxis(1) + faAxis(2) * faAxis(2))
    If faLen > 0.000000000001 Then
        g_faAxis(0) = faAxis(0) / faLen: g_faAxis(1) = faAxis(1) / faLen: g_faAxis(2) = faAxis(2) / faLen
    Else
        g_faAxis(0) = faAxis(0): g_faAxis(1) = faAxis(1): g_faAxis(2) = faAxis(2)
    End If
    g_faAnchorPt(0) = faAnchorPt(0): g_faAnchorPt(1) = faAnchorPt(1): g_faAnchorPt(2) = faAnchorPt(2)

    If DEBUG_MODE_FA Then
        MsgBox "[DEBUG] 紧固件参考几何" & Chr(10) & _
               "faAxis    = (" & Round(g_faAxis(0), 4) & ", " & Round(g_faAxis(1), 4) & ", " & Round(g_faAxis(2), 4) & ")" & Chr(10) & _
               "faAnchorPt= (" & Round(g_faAnchorPt(0), 4) & ", " & Round(g_faAnchorPt(1), 4) & ", " & Round(g_faAnchorPt(2), 4) & ")", _
               vbInformation, "快速装配紧固件 [DEBUG]"
    End If

    CATIA.StatusBar = "请切换到目标产品（CATProduct）文档窗口，然后点击浮动面板上的""继续""按钮。"
    SwitchDocForm_FA.Show vbModeless
End Sub

' ============================================================================
' ContinueSelectProduct_FA - 由 SwitchDocForm_FA.btnContinue_Click() 调用。
' 只做"选目标产品"这一步，完成后显示 FlipForm_FA 并立即返回。
' 装配循环由用户点击 FlipForm_FA.btnStart 逐孔触发（DoSelectAndPlace_FA）。
' ============================================================================
Public Sub ContinueSelectProduct_FA()
    If TypeName(CATIA.ActiveDocument) <> "ProductDocument" Then
        MsgBox "当前活动文档不是 CATProduct。" & Chr(10) & _
               "请先切换到目标产品文档窗口，然后再点击""继续""。", _
               vbExclamation, "快速装配紧固件"
        Exit Sub
    End If

    Unload SwitchDocForm_FA

    Dim rootDoc As Object
    Set rootDoc = CATIA.ActiveDocument
    Dim sel As Object
    Set sel = rootDoc.Selection
    sel.Clear

    ' 选目标产品/部件
    Dim prodFilter As Variant
    prodFilter = Array("Product")
    Dim status As String
    status = sel.SelectElement2(prodFilter, _
        "在产品结构树中选择紧固件要装入的产品/部件", False)
    If status <> "Normal" Then
        MsgBox "已取消选择。", vbInformation, "快速装配紧固件"
        Exit Sub
    End If

    Set targetProduct_FA = Nothing
    On Error Resume Next
    Set targetProduct_FA = sel.Item(1).Value
    On Error GoTo 0

    If targetProduct_FA Is Nothing Or TypeName(targetProduct_FA) <> "Product" Then
        MsgBox "所选对象不是产品或部件。" & Chr(10) & _
               "请在产品结构树中选择一个产品（Product）或部件。", _
               vbExclamation, "快速装配紧固件"
        sel.Clear
        Exit Sub
    End If

    g_targetPN_FA = targetProduct_FA.PartNumber
    sel.Clear

    ' 初始化装配状态
    g_count_FA = 0
    g_hasLastComp_FA = False
    g_loopActive_FA = True
    g_historyCount_FA = 0
    ReDim g_assemblyHistory_FA(0 To 99, 0 To 7)

    ' 显示装配控制面板；UserForm_Activate 会自动调用 DoSelectAndPlace_FA 开始循环
    FlipForm_FA.Show vbModeless
    FlipForm_FA.btnFlip.Enabled = False
    FlipForm_FA.btnUndo.Enabled = False
    CATIA.StatusBar = "目标产品已选定：" & g_targetPN_FA & "  请选择孔位"
End Sub

' ============================================================================
' DoSelectAndPlace_FA - 由 FlipForm_FA.UserForm_Activate 触发，在 FlipForm_FA 的事件
' 调用栈中执行连续"选孔 → 装配"循环，直到用户按 ESC 或点"退出"为止。
' 因为整个循环在 FlipForm_FA 自身的事件里运行，SelectElement2 等待期间
' CATIA 消息泵正常运转，"翻转"/"撤销"/"退出"全程可响应。
' ============================================================================
Public Sub DoSelectAndPlace_FA()
    If Not g_loopActive_FA Then Exit Sub

    Dim sel As Object
    Dim spaAssembly As Object
    Dim firstFilter As Variant
    Dim holeFilter As Variant
    Dim holeAxis(2)
    Dim holePt(2)
    Dim bHoleGeomOK As Boolean
    Dim status As String
    Dim firstRef As Object
    Dim firstLeafProd As Object
    Dim firstMeas As Object
    Dim holeAxisLen As Double
    Dim ptCoord(2)
    Dim ptAxis(2)
    Dim lineRef As Object
    Dim lineLeafProd As Object
    Dim lineMeas As Object
    Dim lineDir(2)
    Dim lineDirLen As Double
    Dim zeroOff(2)

    firstFilter = Array("MonoDim", "Vertex")
    holeFilter = Array("MonoDim")

    Do While g_loopActive_FA

        Set sel = CATIA.ActiveDocument.Selection
        sel.Clear
        Set spaAssembly = CATIA.ActiveDocument.GetWorkbench("SPAWorkbench")
        bHoleGeomOK = False

        ' ── 选孔位元素（圆形边 或 顶点） ──────────────────────────────────
        status = sel.SelectElement2(firstFilter, _
            "选择孔的圆形边（圆弧模式）或安装锚点顶点（点+线模式） [" & g_fastenerPN & " -> " & g_targetPN_FA & _
            "  已装配:" & g_count_FA & "]  按 ESC 或点""退出""结束", False)

        If status <> "Normal" Or Not g_loopActive_FA Then GoTo ExitLoop

        Set firstRef = sel.Item(1).Reference
        Set firstLeafProd = sel.Item(1).LeafProduct

        If Not TryGetMeasurable_FA(spaAssembly, firstRef, firstMeas) Then
            MsgBox "无法测量所选元素，请重新选择。", vbExclamation, "快速装配紧固件"
            sel.Clear
            GoTo NextRound
        End If

        ' ── 圆弧模式 vs 点+线模式 ───────────────────────────────────────
        If TryGetAxis_FA(firstMeas, holeAxis) And TryGetCenter_FA(firstMeas, holePt) Then
            ' 圆弧模式
            holeAxisLen = Sqr(holeAxis(0) * holeAxis(0) + holeAxis(1) * holeAxis(1) + holeAxis(2) * holeAxis(2))
            If holeAxisLen > 0.000000000001 Then
                holeAxis(0) = holeAxis(0) / holeAxisLen
                holeAxis(1) = holeAxis(1) / holeAxisLen
                holeAxis(2) = holeAxis(2) / holeAxisLen
            End If
            Call TransformToRoot(firstLeafProd, holePt, holeAxis)
            Call TransformToTarget_FA(holePt, holeAxis)
            bHoleGeomOK = True
        ElseIf TryGetPoint_FA(firstMeas, ptCoord) Then
            ' 点+线模式：顶点 + 轴线
            ptAxis(0) = 0: ptAxis(1) = 0: ptAxis(2) = 0
            Call TransformToRoot(firstLeafProd, ptCoord, ptAxis)

            sel.Clear
            status = sel.SelectElement2(holeFilter, _
                "【点+线模式】选择轴线方向（直线或轴线）", False)
            If status <> "Normal" Or Not g_loopActive_FA Then GoTo ExitLoop

            Set lineRef = sel.Item(1).Reference
            Set lineLeafProd = sel.Item(1).LeafProduct

            If TryGetMeasurable_FA(spaAssembly, lineRef, lineMeas) And TryGetDirection_FA(lineMeas, lineDir) Then
                lineDirLen = Sqr(lineDir(0) * lineDir(0) + lineDir(1) * lineDir(1) + lineDir(2) * lineDir(2))
                If lineDirLen > 0.000000000001 Then
                    lineDir(0) = lineDir(0) / lineDirLen
                    lineDir(1) = lineDir(1) / lineDirLen
                    lineDir(2) = lineDir(2) / lineDirLen
                End If
                zeroOff(0) = 0: zeroOff(1) = 0: zeroOff(2) = 0
                Call TransformToRoot(lineLeafProd, zeroOff, lineDir)
                Call TransformToTarget_FA(ptCoord, lineDir)
                holePt(0) = ptCoord(0): holePt(1) = ptCoord(1): holePt(2) = ptCoord(2)
                holeAxis(0) = lineDir(0): holeAxis(1) = lineDir(1): holeAxis(2) = lineDir(2)
                bHoleGeomOK = True
            Else
                MsgBox "无法获取所选直线的方向，请选择一条直线或直线型边。", _
                       vbExclamation, "快速装配紧固件"
            End If
        Else
            MsgBox "无法识别所选元素。" & Chr(10) & _
                   "请选择孔入口处的圆形边，或安装锚点（顶点）。", _
                   vbExclamation, "快速装配紧固件"
        End If

        sel.Clear

        If bHoleGeomOK Then
            g_holeAxisX = holeAxis(0): g_holeAxisY = holeAxis(1): g_holeAxisZ = holeAxis(2)
            g_holePtX_FA = holePt(0):     g_holePtY_FA = holePt(1):     g_holePtZ_FA = holePt(2)

            If DEBUG_MODE_FA Then
                MsgBox "[DEBUG] 孔的几何（targetProduct_FA 局部坐标系）" & Chr(10) & _
                       "holeAxis = (" & Round(holeAxis(0), 4) & ", " & Round(holeAxis(1), 4) & ", " & Round(holeAxis(2), 4) & ")" & Chr(10) & _
                       "holePt   = (" & Round(holePt(0), 4) & ", " & Round(holePt(1), 4) & ", " & Round(holePt(2), 4) & ")", _
                       vbInformation, "快速装配紧固件 [DEBUG]"
            End If

            Call PlaceFastenerAtHole

            CATIA.StatusBar = "已装配 " & g_count_FA & " 个 " & g_fastenerPN & " -> " & g_targetPN_FA & _
                              "  [翻转:" & IIf(g_flipDir_FA, "是", "否") & "]  继续选孔，按 ESC 或点""退出""结束"
        End If

NextRound:
    Loop

ExitLoop:
    g_loopActive_FA = False
    g_hasLastComp_FA = False
    sel.Clear
    ' Unload 和 MsgBox 由 UserForm_Activate 在 DoSelectAndPlace_FA 返回后执行
End Sub

' ============================================================================
' TransformToRoot：将点 pt 和方向向量 dir 从 leafProd 局部坐标系
' 逐层正向变换到根产品坐标系（ProductDocument 层）。
' 方向向量只做旋转，不做平移。
' ============================================================================
Private Sub TransformToRoot(ByVal leafProd As Object, ByRef pt(), ByRef dir())
    Dim curProd As Object
    Set curProd = leafProd
    Dim m(11)
    Dim parentColl As Object
    Dim tx As Double, ty As Double, tz As Double

    Do
        Set parentColl = curProd.Parent
        If TypeName(parentColl) = "ProductDocument" Then Exit Do
        curProd.Position.GetComponents m
        ' 点：旋转 + 平移
        tx = m(0) * pt(0) + m(3) * pt(1) + m(6) * pt(2) + m(9)
        ty = m(1) * pt(0) + m(4) * pt(1) + m(7) * pt(2) + m(10)
        tz = m(2) * pt(0) + m(5) * pt(1) + m(8) * pt(2) + m(11)
        pt(0) = tx: pt(1) = ty: pt(2) = tz
        ' 方向：只旋转
        tx = m(0) * dir(0) + m(3) * dir(1) + m(6) * dir(2)
        ty = m(1) * dir(0) + m(4) * dir(1) + m(7) * dir(2)
        tz = m(2) * dir(0) + m(5) * dir(1) + m(8) * dir(2)
        dir(0) = tx: dir(1) = ty: dir(2) = tz
        Set curProd = parentColl.Parent
    Loop
End Sub

' ============================================================================
' TransformToTarget_FA：将根坐标系中的点 pt 和方向 dir 逆变换到
' targetProduct_FA 局部坐标系。
' ============================================================================
Private Sub TransformToTarget_FA(ByRef pt(), ByRef dir())
    ' 收集 targetProduct_FA → 根 的变换链
    Dim chain(49, 11)
    Dim depth As Integer
    depth = 0
    Dim curProd As Object
    Set curProd = targetProduct_FA
    Dim m(11)
    Dim parentColl As Object
    Dim kk As Integer

    Do
        Set parentColl = curProd.Parent
        If TypeName(parentColl) = "ProductDocument" Then Exit Do
        curProd.Position.GetComponents m
        For kk = 0 To 11: chain(depth, kk) = m(kk): Next kk
        depth = depth + 1
        Set curProd = parentColl.Parent
    Loop

    ' 从根向下（逆序）施加逆变换：local = R^T * (parent - T)
    Dim ii As Integer
    Dim off0 As Double, off1 As Double, off2 As Double
    Dim ax As Double, ay As Double, az As Double

    For ii = depth - 1 To 0 Step -1
        off0 = pt(0) - chain(ii, 9)
        off1 = pt(1) - chain(ii, 10)
        off2 = pt(2) - chain(ii, 11)
        pt(0) = chain(ii, 0) * off0 + chain(ii, 1) * off1 + chain(ii, 2) * off2
        pt(1) = chain(ii, 3) * off0 + chain(ii, 4) * off1 + chain(ii, 5) * off2
        pt(2) = chain(ii, 6) * off0 + chain(ii, 7) * off1 + chain(ii, 8) * off2
        ax = chain(ii, 0) * dir(0) + chain(ii, 1) * dir(1) + chain(ii, 2) * dir(2)
        ay = chain(ii, 3) * dir(0) + chain(ii, 4) * dir(1) + chain(ii, 5) * dir(2)
        az = chain(ii, 6) * dir(0) + chain(ii, 7) * dir(1) + chain(ii, 8) * dir(2)
        dir(0) = ax: dir(1) = ay: dir(2) = az
    Next ii
End Sub

' ============================================================================
' PlaceFastenerAtHole
' ============================================================================
Public Sub PlaceFastenerAtHole()
    Dim insertionDir(2) As Double
    If g_flipDir_FA Then
        insertionDir(0) = -g_holeAxisX: insertionDir(1) = -g_holeAxisY: insertionDir(2) = -g_holeAxisZ
    Else
        insertionDir(0) = g_holeAxisX: insertionDir(1) = g_holeAxisY: insertionDir(2) = g_holeAxisZ
    End If

    Dim holeCenterLocal(2) As Double
    holeCenterLocal(0) = g_holePtX_FA: holeCenterLocal(1) = g_holePtY_FA: holeCenterLocal(2) = g_holePtZ_FA

    Dim f1x(2) As Double, f1y(2) As Double, f1z(2) As Double
    f1z(0) = g_faAxis(0): f1z(1) = g_faAxis(1): f1z(2) = g_faAxis(2)
    Call BuildFrame(f1z, f1x, f1y)

    Dim f2x(2) As Double, f2y(2) As Double, f2z(2) As Double
    f2z(0) = insertionDir(0): f2z(1) = insertionDir(1): f2z(2) = insertionDir(2)
    Call BuildFrame(f2z, f2x, f2y)

    Dim R(2, 2) As Double
    Dim ri As Integer, rj As Integer
    For ri = 0 To 2
        For rj = 0 To 2
            R(ri, rj) = FrameCol_FA(ri, 0, f2x, f2y, f2z) * FrameCol_FA(rj, 0, f1x, f1y, f1z) _
                      + FrameCol_FA(ri, 1, f2x, f2y, f2z) * FrameCol_FA(rj, 1, f1x, f1y, f1z) _
                      + FrameCol_FA(ri, 2, f2x, f2y, f2z) * FrameCol_FA(rj, 2, f1x, f1y, f1z)
        Next rj
    Next ri

    Dim rotatedAnchor(2) As Double
    rotatedAnchor(0) = R(0, 0) * g_faAnchorPt(0) + R(0, 1) * g_faAnchorPt(1) + R(0, 2) * g_faAnchorPt(2)
    rotatedAnchor(1) = R(1, 0) * g_faAnchorPt(0) + R(1, 1) * g_faAnchorPt(1) + R(1, 2) * g_faAnchorPt(2)
    rotatedAnchor(2) = R(2, 0) * g_faAnchorPt(0) + R(2, 1) * g_faAnchorPt(1) + R(2, 2) * g_faAnchorPt(2)

    Dim translation(2) As Double
    translation(0) = holeCenterLocal(0) - rotatedAnchor(0)
    translation(1) = holeCenterLocal(1) - rotatedAnchor(1)
    translation(2) = holeCenterLocal(2) - rotatedAnchor(2)

    Dim products As Object
    Set products = targetProduct_FA.products
    products.AddComponent g_fastenerDoc.Product

    Dim newComp As Object
    Set newComp = products.Item(products.Count)

    Dim moveMatrix(11)
    moveMatrix(0) = R(0, 0): moveMatrix(1) = R(1, 0): moveMatrix(2) = R(2, 0)
    moveMatrix(3) = R(0, 1): moveMatrix(4) = R(1, 1): moveMatrix(5) = R(2, 1)
    moveMatrix(6) = R(0, 2): moveMatrix(7) = R(1, 2): moveMatrix(8) = R(2, 2)
    moveMatrix(9) = translation(0)
    moveMatrix(10) = translation(1)
    moveMatrix(11) = translation(2)

    If DEBUG_MODE_FA Then
        MsgBox "[DEBUG] 最终定位矩阵（targetProduct_FA 坐标系）" & Chr(10) & _
               "R X轴 = (" & Round(R(0, 0), 4) & ", " & Round(R(1, 0), 4) & ", " & Round(R(2, 0), 4) & ")" & Chr(10) & _
               "R Y轴 = (" & Round(R(0, 1), 4) & ", " & Round(R(1, 1), 4) & ", " & Round(R(2, 1), 4) & ")" & Chr(10) & _
               "R Z轴 = (" & Round(R(0, 2), 4) & ", " & Round(R(1, 2), 4) & ", " & Round(R(2, 2), 4) & ")" & Chr(10) & _
               "平移  = (" & Round(translation(0), 4) & ", " & Round(translation(1), 4) & ", " & Round(translation(2), 4) & ")", _
               vbInformation, "快速装配紧固件 [DEBUG]"
    End If

    newComp.Position.SetComponents moveMatrix

    Set g_lastProducts_FA = products
    g_lastCompIdx_FA = products.Count
    g_count_FA = g_count_FA + 1
    g_hasLastComp_FA = True
    FlipForm_FA.btnFlip.Enabled = True

    If g_historyCount_FA < 100 Then
        Set g_assemblyHistory_FA(g_historyCount_FA, 0) = products
        g_assemblyHistory_FA(g_historyCount_FA, 1) = products.Count
        g_assemblyHistory_FA(g_historyCount_FA, 2) = g_holeAxisX
        g_assemblyHistory_FA(g_historyCount_FA, 3) = g_holeAxisY
        g_assemblyHistory_FA(g_historyCount_FA, 4) = g_holeAxisZ
        g_assemblyHistory_FA(g_historyCount_FA, 5) = g_holePtX_FA
        g_assemblyHistory_FA(g_historyCount_FA, 6) = g_holePtY_FA
        g_assemblyHistory_FA(g_historyCount_FA, 7) = g_holePtZ_FA
        g_historyCount_FA = g_historyCount_FA + 1
        FlipForm_FA.btnUndo.Enabled = True
    End If
End Sub

' ============================================================================
' MoveLastFastener
' ============================================================================
Public Sub MoveLastFastener()
    Dim lastComp As Object
    Set lastComp = g_lastProducts_FA.Item(g_lastCompIdx_FA)

    Dim insertionDir(2) As Double
    If g_flipDir_FA Then
        insertionDir(0) = -g_holeAxisX: insertionDir(1) = -g_holeAxisY: insertionDir(2) = -g_holeAxisZ
    Else
        insertionDir(0) = g_holeAxisX: insertionDir(1) = g_holeAxisY: insertionDir(2) = g_holeAxisZ
    End If

    Dim holeCenterLocal(2) As Double
    holeCenterLocal(0) = g_holePtX_FA: holeCenterLocal(1) = g_holePtY_FA: holeCenterLocal(2) = g_holePtZ_FA

    Dim f1x(2) As Double, f1y(2) As Double, f1z(2) As Double
    f1z(0) = g_faAxis(0): f1z(1) = g_faAxis(1): f1z(2) = g_faAxis(2)
    Call BuildFrame(f1z, f1x, f1y)

    Dim f2x(2) As Double, f2y(2) As Double, f2z(2) As Double
    f2z(0) = insertionDir(0): f2z(1) = insertionDir(1): f2z(2) = insertionDir(2)
    Call BuildFrame(f2z, f2x, f2y)

    Dim R(2, 2) As Double
    Dim ri As Integer, rj As Integer
    For ri = 0 To 2
        For rj = 0 To 2
            R(ri, rj) = FrameCol_FA(ri, 0, f2x, f2y, f2z) * FrameCol_FA(rj, 0, f1x, f1y, f1z) _
                      + FrameCol_FA(ri, 1, f2x, f2y, f2z) * FrameCol_FA(rj, 1, f1x, f1y, f1z) _
                      + FrameCol_FA(ri, 2, f2x, f2y, f2z) * FrameCol_FA(rj, 2, f1x, f1y, f1z)
        Next rj
    Next ri

    Dim rotatedAnchor(2) As Double
    rotatedAnchor(0) = R(0, 0) * g_faAnchorPt(0) + R(0, 1) * g_faAnchorPt(1) + R(0, 2) * g_faAnchorPt(2)
    rotatedAnchor(1) = R(1, 0) * g_faAnchorPt(0) + R(1, 1) * g_faAnchorPt(1) + R(1, 2) * g_faAnchorPt(2)
    rotatedAnchor(2) = R(2, 0) * g_faAnchorPt(0) + R(2, 1) * g_faAnchorPt(1) + R(2, 2) * g_faAnchorPt(2)

    Dim translation(2) As Double
    translation(0) = holeCenterLocal(0) - rotatedAnchor(0)
    translation(1) = holeCenterLocal(1) - rotatedAnchor(1)
    translation(2) = holeCenterLocal(2) - rotatedAnchor(2)

    Dim moveMatrix(11)
    moveMatrix(0) = R(0, 0): moveMatrix(1) = R(1, 0): moveMatrix(2) = R(2, 0)
    moveMatrix(3) = R(0, 1): moveMatrix(4) = R(1, 1): moveMatrix(5) = R(2, 1)
    moveMatrix(6) = R(0, 2): moveMatrix(7) = R(1, 2): moveMatrix(8) = R(2, 2)
    moveMatrix(9) = translation(0)
    moveMatrix(10) = translation(1)
    moveMatrix(11) = translation(2)

    lastComp.Position.SetComponents moveMatrix
End Sub

' ============================================================================
' UndoLastFastener
' ============================================================================
Public Sub UndoLastFastener()
    If g_historyCount_FA = 0 Then Exit Sub

    Dim lastIdx As Long
    lastIdx = g_historyCount_FA - 1
    Dim products As Object
    Set products = g_assemblyHistory_FA(lastIdx, 0)
    Dim compIdx As Long
    compIdx = CLng(g_assemblyHistory_FA(lastIdx, 1))

    On Error Resume Next
    products.Remove compIdx
    On Error GoTo 0

    Set g_assemblyHistory_FA(lastIdx, 0) = Nothing
    g_assemblyHistory_FA(lastIdx, 1) = 0
    g_historyCount_FA = g_historyCount_FA - 1
    g_count_FA = g_count_FA - 1

    FlipForm_FA.btnUndo.Enabled = (g_historyCount_FA > 0)
    g_hasLastComp_FA = False
    FlipForm_FA.btnFlip.Enabled = False

    CATIA.StatusBar = "已撤销上一个紧固件。当前已装配: " & g_count_FA & " 个 " & g_fastenerPN
End Sub

' ============================================================================
' BuildFrame
' ============================================================================
Private Sub BuildFrame(ByRef inZ() As Double, ByRef outX() As Double, ByRef outY() As Double)
    Dim zLen As Double
    zLen = Sqr(inZ(0) * inZ(0) + inZ(1) * inZ(1) + inZ(2) * inZ(2))
    If zLen < 0.000000000001 Then
        outX(0) = 1: outX(1) = 0: outX(2) = 0
        outY(0) = 0: outY(1) = 1: outY(2) = 0
        Exit Sub
    End If
    Dim nz(2) As Double
    nz(0) = inZ(0) / zLen: nz(1) = inZ(1) / zLen: nz(2) = inZ(2) / zLen

    Dim refV(2) As Double
    If Abs(nz(0)) < 0.9 Then
        refV(0) = 1: refV(1) = 0: refV(2) = 0
    Else
        refV(0) = 0: refV(1) = 1: refV(2) = 0
    End If

    outX(0) = nz(1) * refV(2) - nz(2) * refV(1)
    outX(1) = nz(2) * refV(0) - nz(0) * refV(2)
    outX(2) = nz(0) * refV(1) - nz(1) * refV(0)
    Dim xLen As Double
    xLen = Sqr(outX(0) * outX(0) + outX(1) * outX(1) + outX(2) * outX(2))
    If xLen < 0.000000000001 Then
        outX(0) = 1: outX(1) = 0: outX(2) = 0
        outY(0) = 0: outY(1) = 1: outY(2) = 0
        Exit Sub
    End If
    outX(0) = outX(0) / xLen: outX(1) = outX(1) / xLen: outX(2) = outX(2) / xLen
    outY(0) = nz(1) * outX(2) - nz(2) * outX(1)
    outY(1) = nz(2) * outX(0) - nz(0) * outX(2)
    outY(2) = nz(0) * outX(1) - nz(1) * outX(0)
End Sub

' ============================================================================
' FrameCol_FA
' ============================================================================
Private Function FrameCol_FA(ByVal row As Integer, ByVal col As Integer, _
                          ByRef vx() As Double, ByRef vy() As Double, _
                          ByRef vz() As Double) As Double
    Select Case col
        Case 0: FrameCol_FA = vx(row)
        Case 1: FrameCol_FA = vy(row)
        Case 2: FrameCol_FA = vz(row)
    End Select
End Function

' ============================================================================
' TryGet* 辅助函数（独立错误域）
' ============================================================================
Private Function TryGetAxis_FA(meas As Object, axArr) As Boolean
    On Error Resume Next: Err.Clear
    meas.GetAxis axArr
    TryGetAxis_FA = (Err.Number = 0)
End Function

Private Function TryGetDirection_FA(meas As Object, dirArr) As Boolean
    On Error Resume Next: Err.Clear
    meas.GetDirection dirArr
    TryGetDirection_FA = (Err.Number = 0)
End Function

Private Function TryGetCenter_FA(meas As Object, ptArr) As Boolean
    On Error Resume Next: Err.Clear
    meas.GetCenter ptArr
    TryGetCenter_FA = (Err.Number = 0)
End Function

Private Function TryGetPoint_FA(meas As Object, ptArr) As Boolean
    On Error Resume Next: Err.Clear
    meas.GetPoint ptArr
    TryGetPoint_FA = (Err.Number = 0)
End Function

Private Function TryGetMeasurable_FA(spa As Object, ref As Object, _
                                  ByRef measOut As Object) As Boolean
    On Error Resume Next: Err.Clear
    Set measOut = spa.GetMeasurable(ref)
    TryGetMeasurable_FA = (Err.Number = 0 And Not measOut Is Nothing)
End Function
