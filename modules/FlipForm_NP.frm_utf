Private Sub UserForm_Activate()
    ' 窗体显示后立即进入连续选孔循环
    ' 在 FlipForm_NP 自身的事件调用栈中运行，消息泵不被阻断，四个按钮全程可响应
    Call DoSelectAndPlace_NP
    ' DoSelectAndPlace_NP 返回时循环已退出，在此安全执行收尾
    Unload Me
    MsgBox "装配完成！" & Chr(10) & _
           "共装配 " & g_count_NP & " 个 " & g_nutPlatePN & " 到 " & g_targetPN_NP & "。", _
           vbInformation, "快速装配托板螺母"
End Sub

Private Sub btnFlip_Click()
    If Not g_loopActive_NP Then Exit Sub
    btnFlip.Enabled = False
    g_flipDir_NP = Not g_flipDir_NP
    If g_hasLastComp_NP Then
        Call MoveLastNutPlate
        CATIA.StatusBar = "已重新定向（翻转）  [翻转:" & IIf(g_flipDir_NP, "是", "否") & _
                          "  对调:" & IIf(g_swapHoles_NP, "是", "否") & "]  继续选孔，按 ESC 或点""退出""结束"
    End If
    btnFlip.Enabled = True
End Sub

Private Sub btnSwap_Click()
    If Not g_loopActive_NP Then Exit Sub
    btnSwap.Enabled = False
    g_swapHoles_NP = Not g_swapHoles_NP
    If g_hasLastComp_NP Then
        Call MoveLastNutPlate
        CATIA.StatusBar = "已重新定向（对调）  [翻转:" & IIf(g_flipDir_NP, "是", "否") & _
                          "  对调:" & IIf(g_swapHoles_NP, "是", "否") & "]  继续选孔，按 ESC 或点""退出""结束"
    End If
    btnSwap.Enabled = True
End Sub

Private Sub btnUndo_Click()
    If Not g_loopActive_NP Then Exit Sub
    btnUndo.Enabled = False
    If g_historyCount_NP > 0 Then Call UndoLastNutPlate
End Sub

Private Sub btnStop_Click()
    g_loopActive_NP = False
    g_hasLastComp_NP = False
    On Error Resume Next
    SendKeys "{ESC}", True
    DoEvents
    On Error GoTo 0
End Sub

Private Sub UserForm_QueryClose(Cancel As Integer, CloseMode As Integer)
    If g_loopActive_NP Then
        Cancel = True
        g_loopActive_NP = False
        g_hasLastComp_NP = False
        On Error Resume Next
        SendKeys "{ESC}", True
        DoEvents
        On Error GoTo 0
    End If
End Sub

Private Sub UserForm_Click()

End Sub
